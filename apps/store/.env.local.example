# Better Auth (self-hosted in the store). Any random string of 32+ chars,
# e.g. `openssl rand -hex 32`. Server-only.
BETTER_AUTH_SECRET="<random-32+-char-secret>"
# A GitHub OAuth app whose callback URL is
# http://localhost:3000/api/auth/callback/github (adjust the port if you change STORE_PORT).
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Optional Google sign-in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
