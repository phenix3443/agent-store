{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell-sidecar",
  "description": "Allow running the bundled aas CLI sidecar as `aas __rpc <method> -`, with the arguments written to its stdin, and as `aas __local-api <store origin>`, the read-only endpoint the web store asks",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "binaries/aas", "sidecar": true, "args": ["__rpc", { "validator": "[A-Za-z]+" }, "-"] },
        { "name": "binaries/aas", "sidecar": true, "args": ["__local-api", { "validator": "https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?" }] }
      ]
    },
    "shell:allow-stdin-write",
    "shell:allow-open"
  ]
}
