{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell-sidecar",
  "description": "Allow running the bundled aas CLI sidecar as `aas __rpc <method> -`, with the arguments written to its stdin",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/aas", "sidecar": true, "args": ["__rpc", { "validator": "[A-Za-z]+" }, "-"] }]
    },
    "shell:allow-stdin-write",
    "shell:allow-open"
  ]
}
