{
  "name": "@as/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "type-check": "tsc --noEmit",
    "test": "for f in src/__tests__/*.test.ts; do bun test \"$f\" || exit 1; done",
    "clean": "rm -rf dist *.tsbuildinfo",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/migrate.ts",
    "test:integration": "bun test integration",
    "db:seed": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f ../../db/seed.sql",
    "sync:catalog": "bun src/sync-catalog.ts"
  },
  "dependencies": {
    "@as/types": "workspace:*",
    "@octokit/rest": "^22.0.1",
    "@waffo/pancake-ts": "^0.11.0",
    "drizzle-orm": "^0.44.5",
    "gray-matter": "^4.0.3",
    "hono": "^4.6.0",
    "jose": "^6.2.3",
    "p-map": "^7.1.1",
    "postgres": "4.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.5",
    "typescript": "^5.4.0"
  }
}
